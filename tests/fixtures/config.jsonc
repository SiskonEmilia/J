{
  "commands": {
    "c":   "code",
    "cc":  "claude",
    "g":   "git status",
    "vsc": "open -a \"Visual Studio Code\"",
    "sq":  "echo 'hello world'",
    "bse": "a\\ b"
  },
  "templates": {
    "uProject": {
      "children": {
        "d":   { "path": "Data" },
        "sd":  { "path": "Shared/Data" },
        "src": {
          "path": "Source",
          "children": {
            "pri": { "path": "Private" },
            "pub": { "path": "Public" }
          }
        }
      }
    }
  },
  "roots": {
    "d3": {
      "path": "C:\\projects\\d3",
      "templates": ["uProject"],
      "children": {
        "notes": { "path": "docs\\notes" }
      }
    }
  }
}
